# Copy to .env and replace every placeholder. Do not commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./data/nathavaram.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-10-or-more-characters
JWT_EXPIRE_MINUTES=720
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Leave unset in normal use. 12 is the production default. Tests may set 4.
# BCRYPT_ROUNDS=12
