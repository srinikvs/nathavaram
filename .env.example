# Copy to .env and replace every placeholder. Do not commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./data/nathavaram.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-10-or-more-characters
JWT_EXPIRE_MINUTES=720
# Set to true only behind HTTPS.
COOKIE_SECURE=false
# Leave unset in normal use. 12 is the production default. Tests may set 4.
# BCRYPT_ROUNDS=12

# Campaign messaging (SMS / WhatsApp). Leave unset to stay in dry-run mode
# (messages are recorded locally; nothing is sent externally).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=
# PUBLIC_BASE_URL=https://example.example
# CAMPAIGN_PHOTO_DIR=
# CAMPAIGN_SCHEDULER_SECONDS=30
