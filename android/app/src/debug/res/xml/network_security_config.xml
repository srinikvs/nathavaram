<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow cleartext HTTP so a developer can reach a local server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
